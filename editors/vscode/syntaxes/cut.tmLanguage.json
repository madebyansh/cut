{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CUT",
  "scopeName": "source.cut",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#colors" },
    { "include": "#language-version" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#named-arguments" },
    { "include": "#function-calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cut",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.cut",
          "begin": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.cut" } },
          "end": "\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.cut" } },
          "patterns": [
            {
              "name": "constant.character.escape.cut",
              "match": "\\\\(?:[nrt\"\\\\])"
            },
            {
              "name": "invalid.illegal.escape.cut",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "colors": {
      "patterns": [
        {
          "name": "constant.other.color.rgb-value.cut",
          "match": "#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?(?![0-9A-Fa-f])"
        }
      ]
    },
    "language-version": {
      "patterns": [
        {
          "match": "\\b(cut)(\\s+)([0-9]+\\.[0-9]+)\\b",
          "captures": {
            "1": { "name": "keyword.other.declaration.cut" },
            "3": { "name": "constant.language-version.cut" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(asset|const|let)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.declaration.cut" },
            "2": { "name": "variable.other.definition.cut" }
          }
        },
        {
          "match": "\\b(component|timeline|scene)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.declaration.cut" },
            "2": { "name": "entity.name.function.cut" }
          }
        },
        {
          "match": "\\b(export)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.declaration.cut" },
            "2": { "name": "variable.other.definition.cut" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.declaration.cut",
          "match": "\\b(?:project|import|asset|const|component|timeline|scene|export)\\b"
        },
        {
          "name": "keyword.control.cut",
          "match": "\\b(?:from|as|let|set|animate|to|over|delay|ease|at|for|in|if|else|assert)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.cut",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.null.cut",
          "match": "\\bnull\\b"
        },
        {
          "name": "variable.language.self.cut",
          "match": "\\bself\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.cut",
          "match": "(?<![A-Za-z0-9_])(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:ms|s|f|px|%|deg|rad|dbtp|db|khz|hz|lufs)?(?![A-Za-z0-9_])"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.cut",
          "match": "\\b(?:String|Bool|Boolean|Color|Number|Time|Length|Ratio|Angle|Gain|Frequency|Loudness|TruePeak|List|Array|Range|VideoAsset|AudioAsset|ImageAsset|FontAsset|DataAsset|Data|Visual|AudioNode|AVNode|Timeline|RenderTarget|Easing|Vec2|Vec3|GeoPoint|NoteEvent)\\b"
        },
        {
          "name": "support.type.cut",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b(?!\\s*\\()"
        }
      ]
    },
    "named-arguments": {
      "patterns": [
        {
          "name": "variable.parameter.cut",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*:)"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.cut",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.cut",
          "match": "\\.\\.<|\\.\\.|==|!=|<=|>=|&&|\\|\\||->|[+\\-*/%<>=!]"
        }
      ]
    }
  }
}
