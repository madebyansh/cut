{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://cut.dev/schemas/cut-footage-extract-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["format", "version", "searchSha256", "indexSha256", "matchId", "label", "sourceSelection", "requestedHandles", "effectiveHandles", "finalRange", "toolchain", "output", "extractSha256"],
  "properties": { "format": { "const": "cut-footage-extract" }, "version": { "const": 1 }, "searchSha256": { "$ref": "#/definitions/sha256" }, "indexSha256": { "$ref": "#/definitions/sha256" }, "matchId": { "$ref": "#/definitions/id" }, "label": { "const": "candidate-only-not-cut-lock" }, "sourceSelection": { "$ref": "#/definitions/selection" }, "requestedHandles": { "$ref": "#/definitions/handles" }, "effectiveHandles": { "$ref": "#/definitions/handles" }, "finalRange": { "$ref": "#/definitions/range" }, "toolchain": { "$ref": "#/definitions/toolchain" }, "output": { "$ref": "#/definitions/output" }, "extractSha256": { "$ref": "#/definitions/sha256" } },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "locator": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$" },
    "rational": { "type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": { "numerator": { "type": "string", "pattern": "^(?:0|-?[1-9][0-9]*)$", "maxLength": 256 }, "denominator": { "type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 256 } }, "cutSemantic": "cut-rational-reduced-v1" },
    "range": { "type": "object", "additionalProperties": false, "required": ["semantics", "start", "end"], "properties": { "semantics": { "const": "half-open" }, "start": { "$ref": "#/definitions/rational" }, "end": { "$ref": "#/definitions/rational" } }, "cutSemantic": "cut-half-open-range-v1" },
    "selection": { "type": "object", "additionalProperties": false, "required": ["locator", "sha256", "streamIndex", "range"], "properties": { "locator": { "$ref": "#/definitions/locator" }, "sha256": { "$ref": "#/definitions/sha256" }, "streamIndex": { "type": "integer", "minimum": 0, "maximum": 1024 }, "range": { "$ref": "#/definitions/range" } } },
    "handles": { "type": "object", "additionalProperties": false, "required": ["head", "tail"], "properties": { "head": { "$ref": "#/definitions/rational" }, "tail": { "$ref": "#/definitions/rational" } }, "cutSemantic": "cut-handles-non-negative-v1" },
    "tool": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 128 }, "version": { "type": "string", "minLength": 1, "maxLength": 128 } } },
    "toolchain": { "type": "object", "additionalProperties": false, "required": ["ffmpeg", "ffprobe"], "properties": { "ffmpeg": { "allOf": [{ "$ref": "#/definitions/tool" }, { "properties": { "name": { "const": "ffmpeg" } } }] }, "ffprobe": { "allOf": [{ "$ref": "#/definitions/tool" }, { "properties": { "name": { "const": "ffprobe" } } }] } } },
    "outputStream": { "type": "object", "additionalProperties": false, "required": ["index", "type", "codec"], "properties": { "index": { "type": "integer", "minimum": 0, "maximum": 1024 }, "type": { "enum": ["video", "audio"] }, "codec": { "type": "string", "minLength": 1, "maxLength": 128 } } },
    "output": { "type": "object", "additionalProperties": false, "required": ["locator", "bytes", "sha256", "streams"], "properties": { "locator": { "$ref": "#/definitions/locator" }, "bytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }, "sha256": { "$ref": "#/definitions/sha256" }, "streams": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/definitions/outputStream" } } } }
  }
}
