{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:cut:schema:reference-stems:5",
  "title": "CUT reference stem manifest v5",
  "description": "Closed lock-bound pre-master stem delivery evidence, including explicit auxiliary and Sidechain control dependencies.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "runtime", "lock", "buildId", "composition", "relationship", "stems"],
  "properties": {
    "format": { "const": "cut-reference-stems" },
    "version": { "const": 5 },
    "runtime": { "type": "string", "minLength": 1 },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": { "sha256": { "$ref": "#/definitions/hash" } }
    },
    "buildId": { "$ref": "#/definitions/hash" },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "duration", "sampleRate", "channels", "sampleFormat", "samples"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "duration": { "$ref": "#/definitions/rational" },
        "sampleRate": { "type": "integer", "minimum": 1 },
        "channels": { "const": 2 },
        "sampleFormat": { "const": "s24le" },
        "samples": { "type": "integer", "minimum": 0 }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "mix", "normalization", "peakValidation", "quantization"],
      "properties": {
        "stage": { "const": "pre-master" },
        "mix": { "const": "decoded-sum-with-s24-rounding" },
        "normalization": { "const": "none" },
        "peakValidation": { "const": "exact-f32le-before-quantization" },
        "quantization": { "const": "nearest-ties-to-even" }
      }
    },
    "stems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/stem" }
    }
  },
  "definitions": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nodeId": { "type": "string", "minLength": 1 },
    "stemName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
      "not": { "pattern": "^(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])$" }
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "string", "pattern": "^-?[0-9]+$" },
        "denominator": { "type": "string", "pattern": "^[1-9][0-9]*$" }
      }
    },
    "auxiliaryInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["returnNodeId", "sendNodeId", "sourceStem"],
      "properties": {
        "returnNodeId": { "$ref": "#/definitions/nodeId" },
        "sendNodeId": { "$ref": "#/definitions/nodeId" },
        "sourceStem": { "$ref": "#/definitions/stemName" }
      }
    },
    "sidechainInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sidechainNodeId", "keyNodeId", "sourceStem", "sidechainGraphHash", "keyGraphHash"],
      "properties": {
        "sidechainNodeId": { "$ref": "#/definitions/nodeId" },
        "keyNodeId": { "$ref": "#/definitions/nodeId" },
        "sourceStem": { "$ref": "#/definitions/stemName" },
        "sidechainGraphHash": { "$ref": "#/definitions/hash" },
        "keyGraphHash": { "$ref": "#/definitions/hash" }
      }
    },
    "peak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "sampleFormat", "channels", "expectedFrames", "observedFrames", "expectedBytes", "observedBytes", "thresholdDbfs", "thresholdLinear", "silent", "peakLinear", "peakDbfs", "peakFrame", "peakChannel", "peakChannelName", "peakSample"],
      "properties": {
        "format": { "const": "cut-reference-audio-peak-scan" },
        "version": { "const": 1 },
        "sampleFormat": { "const": "f32le" },
        "channels": { "const": 2 },
        "expectedFrames": { "type": "integer", "minimum": 0 },
        "observedFrames": { "type": "integer", "minimum": 0 },
        "expectedBytes": { "type": "integer", "minimum": 0 },
        "observedBytes": { "type": "integer", "minimum": 0 },
        "thresholdDbfs": { "type": "number" },
        "thresholdLinear": { "type": "number" },
        "silent": { "type": "boolean" },
        "peakLinear": { "type": "number" },
        "peakDbfs": { "type": ["number", "null"] },
        "peakFrame": { "type": ["integer", "null"], "minimum": 0 },
        "peakChannel": { "enum": [0, 1, null] },
        "peakChannelName": { "enum": ["left", "right", null] },
        "peakSample": { "type": ["number", "null"] }
      }
    },
    "stem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "auxiliaryInputs", "sidechainInputs", "nodeId", "graphHash", "file", "sha256", "bytes", "sampleRate", "channels", "sampleFormat", "samples", "peak"],
      "properties": {
        "name": { "$ref": "#/definitions/stemName" },
        "role": { "enum": ["dialogue", "music", "ambience", "sfx"] },
        "kind": { "enum": ["program", "aux"] },
        "auxiliaryInputs": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/definitions/auxiliaryInput" } },
        "sidechainInputs": { "type": "array", "maxItems": 1024, "uniqueItems": true, "items": { "$ref": "#/definitions/sidechainInput" } },
        "nodeId": { "$ref": "#/definitions/nodeId" },
        "graphHash": { "$ref": "#/definitions/hash" },
        "file": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}\\.wav$" },
        "sha256": { "$ref": "#/definitions/hash" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sampleRate": { "type": "integer", "minimum": 1 },
        "channels": { "const": 2 },
        "sampleFormat": { "const": "s24le" },
        "samples": { "type": "integer", "minimum": 0 },
        "peak": { "$ref": "#/definitions/peak" }
      }
    }
  }
}
