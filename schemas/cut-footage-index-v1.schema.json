{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cut.dev/schemas/cut-footage-index-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "root", "sources", "chunkPolicy", "chunks", "backend", "vectorArtifact", "creation", "indexSha256"],
  "properties": {
    "format": { "const": "cut-footage-index" }, "version": { "const": 1 }, "root": { "$ref": "#/$defs/locator" },
    "sources": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/source" } },
    "chunkPolicy": { "$ref": "#/$defs/chunkPolicy" }, "chunks": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/chunk" } },
    "backend": { "$ref": "#/$defs/backend" }, "vectorArtifact": { "$ref": "#/$defs/artifact" },
    "creation": { "type": "object", "additionalProperties": false, "required": ["cutVersion", "backendProtocolVersion"], "properties": { "cutVersion": { "$ref": "#/$defs/text" }, "backendProtocolVersion": { "const": 1 } } },
    "indexSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "locator": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "integer": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "rational": { "type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": { "numerator": { "type": "string", "pattern": "^(?:0|-?[1-9][0-9]*)$", "maxLength": 256 }, "denominator": { "type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 256 } }, "x-cut-semantic": ["cut-rational-reduced-v1"] },
    "range": { "type": "object", "additionalProperties": false, "required": ["semantics", "start", "end"], "properties": { "semantics": { "const": "half-open" }, "start": { "$ref": "#/$defs/rational" }, "end": { "$ref": "#/$defs/rational" } }, "x-cut-semantic": ["cut-half-open-range-v1"] },
    "stream": { "type": "object", "additionalProperties": false, "required": ["index", "type", "timeBase"], "properties": { "index": { "$ref": "#/$defs/integer" }, "type": { "enum": ["video", "audio"] }, "timeBase": { "allOf": [{ "$ref": "#/$defs/rational" }, { "x-cut-semantic": ["cut-rational-positive-v1"] }] }, "frameRate": { "allOf": [{ "$ref": "#/$defs/rational" }, { "x-cut-semantic": ["cut-rational-positive-v1"] }] } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["locator", "bytes", "sha256", "duration", "probeSha256", "streams"], "properties": { "locator": { "$ref": "#/$defs/locator" }, "bytes": { "$ref": "#/$defs/positiveInteger" }, "sha256": { "$ref": "#/$defs/sha256" }, "duration": { "allOf": [{ "$ref": "#/$defs/rational" }, { "x-cut-semantic": ["cut-rational-non-negative-v1"] }] }, "probeSha256": { "$ref": "#/$defs/sha256" }, "streams": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/stream" } } } },
    "chunkPolicy": { "type": "object", "additionalProperties": false, "required": ["duration", "overlap"], "properties": { "duration": { "allOf": [{ "$ref": "#/$defs/rational" }, { "x-cut-semantic": ["cut-rational-positive-v1"] }] }, "overlap": { "allOf": [{ "$ref": "#/$defs/rational" }, { "x-cut-semantic": ["cut-rational-non-negative-v1"] }] } } },
    "chunk": { "type": "object", "additionalProperties": false, "required": ["id", "sourceLocator", "sourceSha256", "streamIndex", "range"], "properties": { "id": { "$ref": "#/$defs/id" }, "sourceLocator": { "$ref": "#/$defs/locator" }, "sourceSha256": { "$ref": "#/$defs/sha256" }, "streamIndex": { "$ref": "#/$defs/integer" }, "range": { "$ref": "#/$defs/range" } } },
    "backend": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "provider", "model", "dimensions", "normalization"], "properties": { "protocolVersion": { "const": 1 }, "provider": { "$ref": "#/$defs/text" }, "model": { "$ref": "#/$defs/text" }, "dimensions": { "type": "integer", "minimum": 1, "maximum": 65536 }, "normalization": { "const": "l2" } } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["locator", "bytes", "sha256"], "properties": { "locator": { "$ref": "#/$defs/locator" }, "bytes": { "$ref": "#/$defs/positiveInteger" }, "sha256": { "$ref": "#/$defs/sha256" } } }
  }
}
