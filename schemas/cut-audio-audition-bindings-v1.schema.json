{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cut:schema:audio-audition-bindings:1",
  "title": "CUT audio audition bindings v1",
  "description": "Closed hash-bound mapping from catalog audio ids to exact project-local audio and rights-evidence files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bindingsSha256", "entries", "format", "version"],
  "properties": {
    "format": { "const": "cut-audio-audition-bindings" },
    "version": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/binding" }
    },
    "bindingsSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "projectLocator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\u0000).+$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audioLocator", "id", "rightsEvidenceLocator"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "audioLocator": { "$ref": "#/$defs/projectLocator" },
        "rightsEvidenceLocator": { "$ref": "#/$defs/projectLocator" }
      }
    }
  },
  "x-cut-semanticConstraints": [
    "bindingsSha256 equals SHA-256 of canonical JSON for format, version and entries",
    "entry ids and audio locators are unique",
    "every id matches one kind=audio catalog entry",
    "audio and rights-evidence locators resolve to authenticated project-local regular files"
  ]
}
