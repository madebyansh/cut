{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cut.dev/schemas/cut-footage-search-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["format", "version", "indexSha256", "query", "matches", "searchSha256"],
  "properties": { "format": { "const": "cut-footage-search" }, "version": { "const": 1 }, "indexSha256": { "$ref": "#/$defs/sha256" }, "query": { "$ref": "#/$defs/query" }, "matches": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/match" } }, "searchSha256": { "$ref": "#/$defs/sha256" } },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "locator": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$" },
    "rational": { "type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": { "numerator": { "type": "string", "pattern": "^(?:0|-?[1-9][0-9]*)$", "maxLength": 256 }, "denominator": { "type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 256 } } },
    "range": { "type": "object", "additionalProperties": false, "required": ["semantics", "start", "end"], "properties": { "semantics": { "const": "half-open" }, "start": { "$ref": "#/$defs/rational" }, "end": { "$ref": "#/$defs/rational" } } },
    "selection": { "type": "object", "additionalProperties": false, "required": ["locator", "sha256", "streamIndex", "range"], "properties": { "locator": { "$ref": "#/$defs/locator" }, "sha256": { "$ref": "#/$defs/sha256" }, "streamIndex": { "type": "integer", "minimum": 0, "maximum": 1024 }, "range": { "$ref": "#/$defs/range" } } },
    "handles": { "type": "object", "additionalProperties": false, "required": ["head", "tail"], "properties": { "head": { "$ref": "#/$defs/rational" }, "tail": { "$ref": "#/$defs/rational" } } },
    "query": { "type": "object", "additionalProperties": false, "required": ["text", "thresholdPpm"], "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" }, "thresholdPpm": { "type": "integer", "minimum": -1000000, "maximum": 1000000 } } },
    "match": { "type": "object", "additionalProperties": false, "required": ["id", "scorePpm", "chunkIds", "sourceSelection"], "properties": { "id": { "$ref": "#/$defs/id" }, "scorePpm": { "type": "integer", "minimum": -1000000, "maximum": 1000000 }, "chunkIds": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/id" } }, "sourceSelection": { "$ref": "#/$defs/selection" }, "handles": { "$ref": "#/$defs/handles" } } }
  }
}
