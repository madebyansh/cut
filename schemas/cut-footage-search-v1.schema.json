{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://cut.dev/schemas/cut-footage-search-v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["format", "version", "indexLocator", "indexSha256", "query", "matches", "searchSha256"],
  "properties": { "format": { "const": "cut-footage-search" }, "version": { "const": 1 }, "indexLocator": { "$ref": "#/definitions/locator" }, "indexSha256": { "$ref": "#/definitions/sha256" }, "query": { "$ref": "#/definitions/query" }, "matches": { "type": "array", "maxItems": 100, "items": { "$ref": "#/definitions/match" } }, "searchSha256": { "$ref": "#/definitions/sha256" } },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "locator": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$" },
    "rational": { "type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": { "numerator": { "type": "string", "pattern": "^(?:0|-?[1-9][0-9]*)$", "maxLength": 256 }, "denominator": { "type": "string", "pattern": "^[1-9][0-9]*$", "maxLength": 256 } }, "cutSemantic": "cut-rational-reduced-v1" },
    "range": { "type": "object", "additionalProperties": false, "required": ["semantics", "start", "end"], "properties": { "semantics": { "const": "half-open" }, "start": { "$ref": "#/definitions/rational" }, "end": { "$ref": "#/definitions/rational" } }, "cutSemantic": "cut-half-open-range-v1" },
    "selection": { "type": "object", "additionalProperties": false, "required": ["locator", "sha256", "streamIndex", "range"], "properties": { "locator": { "$ref": "#/definitions/locator" }, "sha256": { "$ref": "#/definitions/sha256" }, "streamIndex": { "type": "integer", "minimum": 0, "maximum": 1024 }, "range": { "$ref": "#/definitions/range" } } },
    "handles": { "type": "object", "additionalProperties": false, "required": ["head", "tail"], "properties": { "head": { "$ref": "#/definitions/rational" }, "tail": { "$ref": "#/definitions/rational" } }, "cutSemantic": "cut-handles-non-negative-v1" },
    "query": { "type": "object", "additionalProperties": false, "required": ["text", "thresholdPpm"], "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" }, "thresholdPpm": { "type": "integer", "minimum": -1000000, "maximum": 1000000 } } },
    "match": { "type": "object", "additionalProperties": false, "required": ["id", "scorePpm", "chunkIds", "sourceSelection"], "properties": { "id": { "$ref": "#/definitions/id" }, "scorePpm": { "type": "integer", "minimum": -1000000, "maximum": 1000000 }, "chunkIds": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/definitions/id" } }, "sourceSelection": { "$ref": "#/definitions/selection" }, "handles": { "$ref": "#/definitions/handles" } } }
  }
}
