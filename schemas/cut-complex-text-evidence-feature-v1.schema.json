{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cut:schema:complex-text-evidence-feature:1",
  "title": "CUT complex-text evidence feature block v1",
  "description": "Closed schema for the optional features object emitted by shaped frame, contact, preview and render evidence. This is deliberately not a whole-manifest schema.",
