{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cut:schema:audio-brief:1",
  "title": "CUT audio brief v1",
  "description": "Closed hash-bound sample-domain creative direction; never executable automatic edit authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["acts", "briefSha256", "durationSamples", "events", "format", "intentionalSilences", "sampleRate", "sourceScriptSha256", "version"],
  "properties": {
    "format": { "const": "cut-audio-brief" },
    "version": { "const": 1 },
    "sampleRate": { "type": "integer", "minimum": 8000, "maximum": 384000 },
    "durationSamples": { "$ref": "#/$defs/positiveSample" },
    "sourceScriptSha256": { "$ref": "#/$defs/sha256" },
    "acts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/act" }
    },
    "events": {
      "type": "array",
      "maxItems": 8192,
      "items": { "$ref": "#/$defs/event" }
    },
    "intentionalSilences": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/intentionalSilence" }
    },
    "briefSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]+$"
    },
    "mood": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "sample": {
      "type": "integer",
      "minimum": 0,
      "maximum": 33177600000
    },
    "positiveSample": {
      "type": "integer",
      "minimum": 1,
      "maximum": 33177600000
    },
    "ppm": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endSample", "startSample"],
      "properties": {
        "startSample": { "type": "integer", "minimum": 0, "maximum": 33177599999 },
        "endSample": { "$ref": "#/$defs/positiveSample" }
      }
    },
    "act": {
      "type": "object",
      "additionalProperties": false,
      "required": ["densityPpm", "desiredRoles", "dialogueSpacePpm", "energyPpm", "id", "intent", "moods", "narrativeTurn", "range"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "range": { "$ref": "#/$defs/range" },
        "narrativeTurn": { "enum": ["hook", "setup", "accumulation", "rupture", "counterfactual", "propagation", "resolution"] },
        "desiredRoles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["music", "ambience", "sfx", "silence"] }
        },
        "moods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/mood" }
        },
        "energyPpm": { "$ref": "#/$defs/ppm" },
        "densityPpm": { "$ref": "#/$defs/ppm" },
        "dialogueSpacePpm": { "$ref": "#/$defs/ppm" },
        "intent": { "$ref": "#/$defs/boundedText" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "purpose", "sample", "strengthPpm"],
      "properties": {
        "sample": { "$ref": "#/$defs/sample" },
        "kind": { "enum": ["hit", "transition", "riser", "texture"] },
        "purpose": { "$ref": "#/$defs/boundedText" },
        "strengthPpm": { "$ref": "#/$defs/ppm" }
      }
    },
    "intentionalSilence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "range"],
      "properties": {
        "range": { "$ref": "#/$defs/range" },
        "purpose": { "$ref": "#/$defs/boundedText" }
      }
    }
  },
  "x-cut-semanticConstraints": [
    "briefSha256 equals SHA-256 of canonical JSON for every field except briefSha256",
    "all text is trimmed NFC and runtime byte bounds are authoritative",
    "act ids and each act's desired roles and moods are unique",
    "acts are ordered contiguous half-open ranges covering exactly 0 through durationSamples",
    "events are strictly sample-ordered with one event per boundary position and may include durationSamples",
    "intentional silence ranges are non-empty, ordered, nonoverlapping, and bounded by durationSamples",
    "the brief expresses creative direction only and never selects media or applies an edit"
  ]
}
